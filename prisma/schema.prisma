generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// CORRECCIÓN: Los valores de los enums NO llevan punto y coma
enum Role {
  ADMIN
  USER
}

enum DocumentType {
  DNI
  RUC
  CE
}

enum InvoiceStatus {
  PENDING
  COMPLETED
  CANCELLED
  ERROR
}

enum InvoiceType {
  FACTURA
  BOLETA
  NOTA_CREDITO
  NOTA_DEBITO
}

model Product {
  id           Int           @id @default(autoincrement())
  name         String
  description  String?
  barcode      String?       @unique
  price        Decimal       @db.Decimal(10, 2)
  cost         Decimal?      @db.Decimal(10, 2)
  stock        Int           @default(0)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoiceItems InvoiceItem[]
}

model Customer {
  id           Int          @id @default(autoincrement())
  name         String
  document     String       @unique
  documentType DocumentType @default(DNI)
  address      String?
  phone        String?
  email        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  invoices     Invoice[]
}

model Invoice {
  id           Int           @id @default(autoincrement())
  customerId   Int
  type         InvoiceType   @default(BOLETA)
  serie        String
  number       Int
  
  // Si no tienes un modelo "Sale", añade esto para vincularlo a tu histórico
  saleId       Int?          @unique 

  taxedAmount  Decimal       @default(0) @db.Decimal(10, 2)
  igv          Decimal       @default(0) @db.Decimal(10, 2)
  total        Decimal       @default(0) @db.Decimal(10, 2)
  
  status       InvoiceStatus @default(PENDING)
  sunatStatus  String?
  sunatResponse Json?
  hash         String?
  pdfUrl       String?
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id])
  items        InvoiceItem[]

  @@unique([serie, number])
  @@index([customerId])
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  productId Int
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  igv       Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

model Business {
  id             Int      @id @default(1)
  name           String
  ruc            String   @unique
  address        String?
  district       String?
  city           String?
  nubefact_token String?
  nubefact_url   String?
  createdAt      DateTime @default(now())
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role   @default(USER)
}

model Settings {
  id           Int      @id @default(1)
  igv          Float    @default(18)
  facturaSerie String   @default("F001")
  boletaSerie  String   @default("B001")
  ticketFooter String?
  updatedAt    DateTime @updatedAt
}